# OpenAI (https://platform.openai.com) — used directly for chat/synthesis
# and for embeddings (query-time retrieval in backend/retrieval/vector_store.py,
# and ingestion). Changing OPENAI_EMBEDDING_MODEL requires re-ingesting the KB
# and matching the VECTOR(...) column width in ingestion/embedding.py's schema
# to its output dimension.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Local Docker services (docker compose up -d) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orthopedics-dev

# Postgres with pgvector — checkpointer/store, document/ingestion metadata,
# feedback, eval results, and the vector chunk index all live here.
DATABASE_URL=postgresql://orthopedics:orthopedics-dev@localhost:5432/orthopedics_agents

# Raw ingested documents live on disk, not object storage — a Railway
# volume mounted at this path in production.
INGEST_DATA_DIR=./data

# --- Auth ---
# Signs session JWTs. The code falls back to an insecure dev default if this
# is unset, but always set a real random value in production.
JWT_SECRET=
# Comma-separated emails granted is_admin at signup (gates the Document
# Manager and Evals pages) — see agents.md.
ADMIN_EMAILS=

# Google OAuth (Sign in with Google) — create an OAuth client in Google Cloud
# Console and add "{OAUTH_REDIRECT_BASE_URL}/auth/google/callback" as an
# authorized redirect URI (exact match required by Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The backend's own externally-reachable base URL, used to build that
# redirect URI. In production this is the single Railway service's URL; the
# local default below matches uvicorn's default port.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Where to send the browser after a Google login completes. Only needed
# locally, where the frontend (:3000) and backend (:8000) are separate
# processes — leave unset in production, where they're the same origin
# (ADR 0004) and a relative redirect already lands in the right place.
FRONTEND_PUBLIC_URL=http://localhost:3000

# --- Observability ---
# Point at any OTLP collector (local, self-hosted, or a SaaS one) — leave
# unset to no-op. Used for both local dev and production; there's no
# Azure-specific export path.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Langfuse (optional local step — see README "Local Development")
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Railway sets PORT itself; only set this manually for local Docker testing.
PORT=8000
